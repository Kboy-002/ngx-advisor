# --- Postgres ---
POSTGRES_DB=ngx_advisor
POSTGRES_USER=ngx
POSTGRES_PASSWORD=change_me_before_first_run
POSTGRES_PORT=5432

# --- Services ---
APP_PORT=8000
DASHBOARD_PORT=8501

# --- Data sources (free-first MVP) ---
# Kobo Terminal Personal key — FREE, instant, 100 req/day (all 150+ NGX prices + ASI in 2 calls).
# Get one at https://koboterminal.com (API section) and paste below. Without it the app
# runs on your uploaded Afrinvest prices + a warming-up NGX scrape (currently bot-blocked).
# Leave blank to run on NGX scrape only.
KOBO_API_KEY=
NGNMARKET_API_KEY=
NGX_PRICE_LIST_URL=https://ngxgroup.com/exchange/data/equities-price-list/

# Scheduler timezone
TZ=Africa/Lagos
